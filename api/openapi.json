{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "MANDAT API",
    "version" : "v1"
  },
  "tags" : [ {
    "description" : "Level, XP, streak and wallet summary",
    "name" : "Progression"
  }, {
    "description" : "Daily and weekly missions",
    "name" : "Missions"
  }, {
    "description" : "Free season pass",
    "name" : "Season pass"
  }, {
    "description" : "Sign-up, sign-in and token lifecycle",
    "name" : "Auth"
  }, {
    "description" : "The authenticated player's account, settings and summary",
    "name" : "Me"
  }, {
    "description" : "Achievements and their progress",
    "name" : "Achievements"
  }, {
    "description" : "Connectivity and server time",
    "name" : "Meta"
  } ],
  "paths" : {
    "/api/v1/achievements" : {
      "get" : {
        "operationId" : "getAchievements",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AchievementsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Every achievement with the player's progress",
        "tags" : [ "Achievements" ]
      }
    },
    "/api/v1/auth/apple" : {
      "post" : {
        "operationId" : "signInWithApple",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SocialLoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in (or sign up) with an Apple ID token",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/google" : {
      "post" : {
        "operationId" : "signInWithGoogle",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SocialLoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in (or sign up) with a Google ID token",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in with email and password",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Revoke the refresh token family of this device",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "operationId" : "refreshTokens",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Exchange a refresh token for new tokens (rotation; reusing a token revokes its family)",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthResponse"
                }
              }
            },
            "description" : "Created"
          }
        },
        "summary" : "Create an account with email and password",
        "tags" : [ "Auth" ]
      }
    },
    "/api/v1/me" : {
      "delete" : {
        "operationId" : "deleteMe",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Permanently delete the account and all its data",
        "tags" : [ "Me" ]
      },
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Account, settings, wallet and the sections of other domains",
        "tags" : [ "Me" ]
      }
    },
    "/api/v1/me/settings" : {
      "patch" : {
        "operationId" : "updateMySettings",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateSettingsRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SettingsDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Partially update the player's settings",
        "tags" : [ "Me" ]
      }
    },
    "/api/v1/meta" : {
      "get" : {
        "operationId" : "getMeta",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MetaResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "API name, version and authoritative server time",
        "tags" : [ "Meta" ]
      }
    },
    "/api/v1/missions" : {
      "get" : {
        "operationId" : "getMissions",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MissionsResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Current daily and weekly missions with progress",
        "tags" : [ "Missions" ]
      }
    },
    "/api/v1/missions/{missionId}/claim" : {
      "post" : {
        "operationId" : "claimMission",
        "parameters" : [ {
          "in" : "path",
          "name" : "missionId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Claim the reward of a completed mission",
        "tags" : [ "Missions" ]
      }
    },
    "/api/v1/progression" : {
      "get" : {
        "operationId" : "getProgression",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProgressionResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Level, XP, streak, resets and wallet of the player",
        "tags" : [ "Progression" ]
      }
    },
    "/api/v1/season-pass" : {
      "get" : {
        "operationId" : "getSeasonPass",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SeasonPassResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Season pass tiers, season XP and claim state",
        "tags" : [ "Season pass" ]
      }
    },
    "/api/v1/season-pass/{tier}/claim" : {
      "post" : {
        "operationId" : "claimSeasonPassTier",
        "parameters" : [ {
          "in" : "path",
          "name" : "tier",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "Claim the reward of a reached tier",
        "tags" : [ "Season pass" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "Account" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "friendCode" : {
            "type" : "string"
          },
          "hasPassword" : {
            "type" : "boolean"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "linkedProviders" : {
            "type" : "array",
            "description" : "Linked social providers",
            "enum" : [ "APPLE", "GOOGLE" ],
            "items" : {
              "type" : "string"
            }
          },
          "nickname" : {
            "type" : "string"
          }
        },
        "required" : [ "createdAt", "friendCode", "hasPassword", "id", "linkedProviders", "nickname" ]
      },
      "AchievementDto" : {
        "type" : "object",
        "properties" : {
          "category" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "description" : "Stable key, mapped to i18n by the app"
          },
          "metric" : {
            "type" : "string"
          },
          "param" : {
            "type" : [ "string", "null" ]
          },
          "progress" : {
            "type" : "integer",
            "format" : "int32"
          },
          "reward" : {
            "$ref" : "#/components/schemas/RewardDto"
          },
          "threshold" : {
            "type" : "integer",
            "format" : "int32"
          },
          "unlockedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          }
        },
        "required" : [ "category", "id", "metric", "progress", "reward", "threshold" ]
      },
      "AchievementsResponse" : {
        "type" : "object",
        "properties" : {
          "achievements" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AchievementDto"
            }
          },
          "totalCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "unlockedCount" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "achievements", "totalCount", "unlockedCount" ]
      },
      "AuthResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "accessTokenExpiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "newUser" : {
            "type" : "boolean",
            "description" : "True when this request created the account (e.g. first social sign-in)"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "refreshTokenExpiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "tokenType" : {
            "type" : "string",
            "enum" : [ "Bearer" ]
          },
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "accessToken", "accessTokenExpiresAt", "newUser", "refreshToken", "refreshTokenExpiresAt", "tokenType", "userId" ]
      },
      "ClaimResponse" : {
        "type" : "object",
        "properties" : {
          "level" : {
            "type" : "integer",
            "format" : "int32"
          },
          "levelRewards" : {
            "$ref" : "#/components/schemas/RewardDto"
          },
          "levelsGained" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "reward" : {
            "$ref" : "#/components/schemas/RewardDto"
          },
          "totalXp" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "level", "levelRewards", "levelsGained", "reward", "totalXp" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "deviceLabel" : {
            "type" : [ "string", "null" ],
            "maxLength" : 64,
            "minLength" : 0
          },
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "LogoutRequest" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "refreshToken" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "account" : {
            "$ref" : "#/components/schemas/Account"
          },
          "sections" : {
            "type" : "object",
            "additionalProperties" : { },
            "description" : "Sections added by other domains (progression, packs...), keyed by MeContributor#key"
          },
          "serverTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "settings" : {
            "$ref" : "#/components/schemas/SettingsDto"
          },
          "wallet" : {
            "$ref" : "#/components/schemas/Wallet"
          }
        },
        "required" : [ "account", "sections", "serverTime", "settings", "wallet" ]
      },
      "MetaResponse" : {
        "type" : "object",
        "properties" : {
          "apiVersion" : {
            "type" : "string"
          },
          "appName" : {
            "type" : "string"
          },
          "serverTime" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "apiVersion", "appName", "serverTime" ]
      },
      "MissionDto" : {
        "type" : "object",
        "properties" : {
          "claimed" : {
            "type" : "boolean"
          },
          "completed" : {
            "type" : "boolean"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "param" : {
            "type" : [ "string", "null" ],
            "description" : "Continent key for continent missions"
          },
          "period" : {
            "type" : "string",
            "enum" : [ "daily", "weekly" ]
          },
          "progress" : {
            "type" : "integer",
            "format" : "int32"
          },
          "reward" : {
            "$ref" : "#/components/schemas/RewardDto"
          },
          "target" : {
            "type" : "integer",
            "format" : "int32"
          },
          "templateId" : {
            "type" : "string",
            "description" : "Stable template key, mapped to i18n by the app"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "claimed", "completed", "id", "period", "progress", "reward", "target", "templateId", "type" ]
      },
      "MissionsResponse" : {
        "type" : "object",
        "properties" : {
          "daily" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MissionDto"
            }
          },
          "dailyResetAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "weekly" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MissionDto"
            }
          },
          "weeklyResetAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "daily", "dailyResetAt", "weekly", "weeklyResetAt" ]
      },
      "ProgressionResponse" : {
        "type" : "object",
        "properties" : {
          "bestStreak" : {
            "type" : "integer",
            "format" : "int32"
          },
          "bonusPacks" : {
            "type" : "integer",
            "format" : "int32"
          },
          "currentStreak" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Streak as of today (0 when broken)"
          },
          "dailyResetAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "freezeAvailable" : {
            "type" : "boolean",
            "description" : "This week's free streak freeze is unused"
          },
          "influence" : {
            "type" : "integer",
            "format" : "int32"
          },
          "level" : {
            "type" : "integer",
            "format" : "int32"
          },
          "seasonXp" : {
            "type" : "integer",
            "format" : "int32"
          },
          "streakActiveToday" : {
            "type" : "boolean",
            "description" : "A streak activity was already done today"
          },
          "timezone" : {
            "type" : "string"
          },
          "totalXp" : {
            "type" : "integer",
            "format" : "int32"
          },
          "unlocks" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/UnlockDto"
            }
          },
          "weeklyResetAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "xpForNextLevel" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "description" : "XP needed for the next level, null at max level"
          },
          "xpIntoLevel" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "XP earned since the current level was reached"
          }
        },
        "required" : [ "bestStreak", "bonusPacks", "currentStreak", "dailyResetAt", "freezeAvailable", "influence", "level", "seasonXp", "streakActiveToday", "timezone", "totalXp", "unlocks", "weeklyResetAt", "xpIntoLevel" ]
      },
      "RefreshRequest" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "refreshToken" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "deviceLabel" : {
            "type" : [ "string", "null" ],
            "maxLength" : 64,
            "minLength" : 0
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "language" : {
            "type" : [ "string", "null" ],
            "enum" : [ "fr", "en" ],
            "pattern" : "fr|en"
          },
          "nickname" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "^[\\p{L}\\p{N}_.\\-]{3,20}$"
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 8
          },
          "timezone" : {
            "type" : [ "string", "null" ],
            "example" : "Europe/Paris",
            "maxLength" : 64,
            "minLength" : 0
          }
        },
        "required" : [ "email", "nickname", "password" ]
      },
      "RewardDto" : {
        "type" : "object",
        "properties" : {
          "bonusPacks" : {
            "type" : "integer",
            "format" : "int32"
          },
          "influence" : {
            "type" : "integer",
            "format" : "int32"
          },
          "unlocks" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/UnlockDto"
            }
          },
          "xp" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "bonusPacks", "influence", "unlocks", "xp" ]
      },
      "SeasonPassResponse" : {
        "type" : "object",
        "properties" : {
          "currentTier" : {
            "type" : "integer",
            "format" : "int32"
          },
          "seasonId" : {
            "type" : "string"
          },
          "seasonXp" : {
            "type" : "integer",
            "format" : "int32"
          },
          "tiers" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TierDto"
            }
          },
          "xpPerTier" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "currentTier", "seasonId", "seasonXp", "tiers", "xpPerTier" ]
      },
      "SettingsDto" : {
        "type" : "object",
        "properties" : {
          "haptics" : {
            "type" : "boolean"
          },
          "language" : {
            "type" : "string"
          },
          "notifications" : {
            "type" : "boolean"
          },
