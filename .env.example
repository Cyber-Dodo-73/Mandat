# PostgreSQL
POSTGRES_DB=mandat
POSTGRES_USER=mandat
POSTGRES_PASSWORD=change-me

# API
SPRING_PROFILES_ACTIVE=prod
# Public URL once deployed (Dokploy + Traefik): https://mandat.cyber-dodo.fr
# The native app doesn't need CORS; only list browser origins (e.g. an admin site). Empty = none allowed.
MANDAT_CORS_ALLOWED_ORIGINS=
# Swagger UI and /v3/api-docs. Always off with the prod profile, whatever this says.
MANDAT_API_DOCS_ENABLED=true
# Access-token signing key, at least 32 bytes. Generate one with: openssl rand -base64 48
MANDAT_JWT_SECRET=
# Accepted ID-token audiences, comma-separated. Add host.exp.Exponent to test Apple sign-in in Expo Go.
MANDAT_APPLE_CLIENT_IDS=fr.cyberdodo.mandat
MANDAT_GOOGLE_CLIENT_IDS=

# Push notifications (Expo push service). The access token is only needed when
# "Enhanced push security" is enabled on expo.dev. Set MANDAT_PUSH_ENABLED=false to mute every send.
MANDAT_EXPO_ACCESS_TOKEN=
MANDAT_PUSH_ENABLED=true

# Public URL of the API, used in emailed links (password reset).
MANDAT_PUBLIC_BASE_URL=https://mandat.cyber-dodo.fr
# Key for secrets stored in the database (Apple refresh tokens). Empty = derived from MANDAT_JWT_SECRET.
# Set it (openssl rand -base64 48) before rotating the JWT secret, or stored tokens become unreadable.
MANDAT_DATA_KEY=

# Sign in with Apple key (developer account > Certificates, IDs & Profiles > Keys, "Sign in with Apple"),
# used to revoke the Apple authorization when a player deletes the account (App Store requirement).
# MANDAT_APPLE_PRIVATE_KEY is the .p8 content; "\n" escapes are accepted. Empty = revocation skipped.
MANDAT_APPLE_TEAM_ID=
MANDAT_APPLE_KEY_ID=
MANDAT_APPLE_PRIVATE_KEY=

# SMTP relay for transactional emails (password reset). Empty host = emails are logged, not sent.
MANDAT_SMTP_HOST=
MANDAT_SMTP_PORT=587
MANDAT_SMTP_USERNAME=
MANDAT_SMTP_PASSWORD=
MANDAT_SMTP_FROM=MANDAT <no-reply@cyber-dodo.fr>

# Optional Slack/Discord-compatible webhook called on each new player report (no personal data).
MANDAT_MODERATION_WEBHOOK=

# Legal pages (/legal/privacy, /legal/terms, /legal/notice, /support). Bump MANDAT_TERMS_VERSION when
# the terms change: players are asked to accept them again.
MANDAT_TERMS_VERSION=2026-10-19
MANDAT_OPERATOR_NAME=
MANDAT_OPERATOR_ADDRESS=
MANDAT_CONTACT_EMAIL=contact@cyber-dodo.fr
MANDAT_HOSTING_PROVIDER=

# The season catalog (data/cards.season1.json) is baked into the API image at build time.
API_DOMAIN=mandat.cyber-dodo.fr

# Sentry error reporting for the API (project "mandat-api" on sentry.io). Empty: off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
