# PostgreSQL
POSTGRES_DB=mandat
POSTGRES_USER=mandat
POSTGRES_PASSWORD=change-me

# API
SPRING_PROFILES_ACTIVE=prod
# Public URL once deployed (Dokploy + Traefik): https://mandat.cyber-dodo.fr
# The native app doesn't need CORS; only list browser origins (e.g. an admin site). Empty = none allowed.
MANDAT_CORS_ALLOWED_ORIGINS=
# Swagger UI and /v3/api-docs; set to false to hide them in production.
MANDAT_API_DOCS_ENABLED=true
# Access-token signing key, at least 32 bytes. Generate one with: openssl rand -base64 48
MANDAT_JWT_SECRET=
# Accepted ID-token audiences, comma-separated. Add host.exp.Exponent to test Apple sign-in in Expo Go.
MANDAT_APPLE_CLIENT_IDS=fr.cyberdodo.mandat
MANDAT_GOOGLE_CLIENT_IDS=

# Push notifications (Expo push service). The access token is only needed when
# "Enhanced push security" is enabled on expo.dev. Set MANDAT_PUSH_ENABLED=false to mute every send.
MANDAT_EXPO_ACCESS_TOKEN=
MANDAT_PUSH_ENABLED=true

# The season catalog (data/cards.season1.json) is baked into the API image at build time.
API_DOMAIN=mandat.cyber-dodo.fr
