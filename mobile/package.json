{
  "name": "mandat-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.5.2",
    "lottie-react-native": "~7.5.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.12.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "api:gen": "npm exec --yes -- openapi-typescript@7.13.0 ../api/openapi.json -o src/lib/api/schema.d.ts",
    "start:tunnel": "expo start --go --tunnel",
    "start:dev-client": "expo start --dev-client"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets",
        "react-native-reanimated"
      ]
    }
  },
  "overrides": {
    "react-native-reanimated": {
      "react-native": "$react-native"
    },
    "react-native-worklets": {
      "react-native": "$react-native"
    },
    "expo-modules-core": {
      "react-native-worklets": "$react-native-worklets"
    }
  }
}
