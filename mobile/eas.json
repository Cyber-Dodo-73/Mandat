{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mandat.cyber-dodo.fr"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "development": {},
    "production": {}
  }
}
