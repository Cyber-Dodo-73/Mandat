# Base URL of the MANDAT API. Defaults to production (https://mandat.cyber-dodo.fr).
# To hit a local API from the phone, use your machine LAN IP, e.g. http://192.168.1.20:8080
EXPO_PUBLIC_API_URL=https://mandat.cyber-dodo.fr
# Google sign-in (OAuth client ids from Google Cloud). The Google button stays hidden when empty.
# The iOS id must also be listed in the API's MANDAT_GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
